# Copy to .env.local and fill in. .env.local is gitignored.

# Public origin, no trailing slash. Used by sitemap.xml, robots.txt and Open
# Graph image URLs. Must match the canonical hostname exactly — if the site is
# served from www, this has to say www, or search engines see two sites.
NEXT_PUBLIC_SITE_URL=https://www.yantracabs.com

# Supabase → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS — never expose it to the browser and never prefix
# it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=


# ---- Razorpay (not wired up yet — phase 2) ----
# Test keys work immediately after signup; live keys need KYC approval.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# NEXT_PUBLIC_RAZORPAY_KEY_ID=
